rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return firestore.get(/databases/(default)/documents/users/$(uid));
    }

    function userExists(uid) {
      return firestore.exists(/databases/(default)/documents/users/$(uid));
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasRole(role) {
      return signedIn()
        && userExists(request.auth.uid)
        && (
          userDoc(request.auth.uid).data.role == role
          || (
            userDoc(request.auth.uid).data.roles is list
            && role in userDoc(request.auth.uid).data.roles
          )
        );
    }

    function isStaff() {
      return hasRole('admin')
        || hasRole('superAdmin')
        || hasRole('super_admin')
        || hasRole('staff')
        || hasRole('owner');
    }

    function vendorDoc(vendorId) {
      return firestore.get(/databases/(default)/documents/vendors/$(vendorId));
    }

    function isVendorOwner(vendorId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/vendors/$(vendorId))
        && vendorDoc(vendorId).data.ownerId == request.auth.uid;
    }

    // Step H2: the caller owns vendors/{vendorId} and it is approved and
    // active (read from the vendors doc, never from users.vendorId).
    function isApprovedVendorOwner(vendorId) {
      return isVendorOwner(vendorId)
        && vendorDoc(vendorId).data.get('status', '') in ['approved', 'Approved']
        && vendorDoc(vendorId).data.get('isActive', true) != false;
    }

    // ---- 14b step B: who may see vendor / rider identity documents ----
    // Same roles as Firestore vendor_private / delivery_partner_private:
    // superAdmin, admin (their default permissions include vendors.view and
    // delivery.view), or an explicit permission (list or map form; the
    // perms lists here have at most 4 entries).
    function userHasAnyPermission(perms) {
      let u = userDoc(request.auth.uid).data;
      let role = u.get('role', '');
      let roles = u.get('roles', []);
      let granted = u.get('permissions', []);
      return u.get('isActive', true) != false
        && u.get('isBanned', false) != true
        && (
          role in ['superAdmin', 'super_admin', 'admin']
          || (roles is list && roles.hasAny(['superAdmin', 'super_admin', 'admin']))
          || (granted is list && granted.hasAny(perms))
          || (granted is map && (
              granted.get(perms[0], false) == true
              || (perms.size() > 1 && granted.get(perms[1], false) == true)
              || (perms.size() > 2 && granted.get(perms[2], false) == true)
              || (perms.size() > 3 && granted.get(perms[3], false) == true)))
        );
    }

    function canSeeVendorDocuments() {
      return signedIn()
        && userExists(request.auth.uid)
        && userHasAnyPermission(['vendors.view', 'vendors.edit', 'vendors.approve', 'vendors.payouts']);
    }

    function canSeeRiderDocuments() {
      return signedIn()
        && userExists(request.auth.uid)
        && userHasAnyPermission(['delivery.view', 'delivery.approve', 'delivery.block']);
    }

    function isSuperAdminStorage() {
      return hasRole('superAdmin') || hasRole('super_admin');
    }

    // The vendor application is still open: no vendor doc yet, or it is
    // pending / submitted / rejected / new (the states in which Firestore
    // lets the applicant edit).
    function vendorApplicationOpen(vendorId) {
      return !firestore.exists(/databases/(default)/documents/vendors/$(vendorId))
        || vendorDoc(vendorId).data.get('status', '') in ['pending', 'submitted', 'rejected', 'new'];
    }

    // The rider application is still open: no rider doc yet, or pending/rejected.
    function riderApplicationOpen(uid) {
      return !firestore.exists(/databases/(default)/documents/deliveryPartners/$(uid))
        || firestore.get(/databases/(default)/documents/deliveryPartners/$(uid)).data.get('status', '') in ['pending', 'rejected'];
    }

    function isJpegPngWebp() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType == 'application/octet-stream';
    }

    function isSafeImage(maxBytes) {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= maxBytes
        && isJpegPngWebp();
    }

    function isImageUnder5MB() {
      return isSafeImage(5 * 1024 * 1024);
    }

    function isImageUnder10MB() {
      return isSafeImage(10 * 1024 * 1024);
    }

    // =========================
    // USER LIST / PRESCRIPTION IMAGES
    // =========================
    match /lists/{uid}/{fileName} {
      allow read: if isOwner(uid) || isStaff();
      allow create, update: if isOwner(uid) && isImageUnder5MB();
      allow delete: if isOwner(uid) || isStaff();
    }

    match /prescriptions/{uid}/{fileName} {
      allow read: if isOwner(uid) || isStaff();
      allow create, update: if isOwner(uid) && isImageUnder5MB();
      allow delete: if isOwner(uid) || isStaff();
    }

    match /prescription_images/{uid}/{fileName} {
      allow read: if isOwner(uid) || isStaff();
      allow create, update: if isOwner(uid) && isImageUnder5MB();
      allow delete: if isOwner(uid) || isStaff();
    }

    // =========================
    // DELIVERY PARTNER DOCUMENTS
    // =========================
    // NID front/back. Read: the rider and rider managers only (14b step B;
    // before, any staff role). Write: the rider while the application is
    // open; afterwards nobody from the app (admin SDK still can).
    match /delivery_partner_documents/{uid}/{fileName} {
      allow read: if isOwner(uid) || canSeeRiderDocuments();
      allow create, update: if isOwner(uid) && riderApplicationOpen(uid) && isImageUnder5MB();
      allow delete: if (isOwner(uid) && riderApplicationOpen(uid)) || isSuperAdminStorage();
    }

    // =========================
    // PUBLIC CATEGORY IMAGES
    // =========================
    match /categories/{fileName} {
      allow read: if true;
      allow create, update: if isStaff() && isImageUnder5MB();
      allow delete: if isStaff();
    }

    match /category_images/{fileName} {
      allow read: if true;
      allow create, update: if isStaff() && isImageUnder5MB();
      allow delete: if isStaff();
    }

    // =========================
    // PUBLIC PRODUCT IMAGES (shop products)
    // Step H2: staff only. Before, any "vendor" could upload here and
    // overwrite any shop image, and a customer counted as a vendor once
    // they had put any id in their own users.vendorId.
    // Vendors use vendor_products/{vendorId}/ (below).
    // =========================
    match /products/{fileName} {
      allow read: if true;
      allow create, update: if isStaff() && isImageUnder10MB();
      allow delete: if isStaff();
    }

    match /product_images/{fileName} {
      allow read: if true;
      allow create, update: if isStaff() && isImageUnder10MB();
      allow delete: if isStaff();
    }

    // =========================
    // PUBLIC BANNERS
    // =========================
    match /banners/{fileName} {
      allow read: if true;
      allow create, update: if isStaff() && isImageUnder5MB();
      allow delete: if isStaff();
    }

    // =========================
    // VENDOR DOCUMENTS
    // IMPORTANT: vendorId may be vendor document ID, not Firebase Auth UID.
    // Read is restricted to real vendor owner from vendors/{vendorId}.ownerId or staff.
    // Create/update also supports initial application path where vendorId == request.auth.uid.
    // =========================
    match /vendors/{vendorId}/documents/{fileName} {
      // NID front/back and trade license. vendorId is the owner's uid
      // (vendor_apply_page) or a vendor doc whose ownerId is the caller.
      // Read: the owner and vendor managers only (14b step B; before, any
      // staff role). Write: the owner while the application is open.
      allow read: if isOwner(vendorId) || isVendorOwner(vendorId) || canSeeVendorDocuments();

      allow create, update: if (isOwner(vendorId) || isVendorOwner(vendorId))
        && vendorApplicationOpen(vendorId)
        && isImageUnder5MB();

      allow delete: if ((isOwner(vendorId) || isVendorOwner(vendorId)) && vendorApplicationOpen(vendorId))
        || isSuperAdminStorage();
    }

    // =========================
    // VENDOR PRODUCT IMAGES
    // =========================
    // Step H2: only the owner of an approved, active vendor (vendors doc),
    // only in that vendor's own folder. Before, any customer could store
    // public files under vendor_products/{own uid}/.
    match /vendor_products/{vendorId}/{fileName} {
      allow read: if true;
      allow create, update: if isApprovedVendorOwner(vendorId) && isImageUnder10MB();
      allow delete: if isApprovedVendorOwner(vendorId) || isStaff();
    }

    // =========================
    // GENERAL PUBLIC READ
    // =========================
    match /public/{allPaths=**} {
      allow read: if true;
      allow create, update: if isStaff() && isImageUnder5MB();
      allow delete: if isStaff();
    }

    // =========================
    // DOCTOR / DEPARTMENT IMAGES
    // =========================
    match /doctor_departments/{allPaths=**} {
      allow read: if true;
      allow create, update: if isStaff() && isImageUnder5MB();
      allow delete: if isStaff();
    }

    match /doctor_depts/{allPaths=**} {
      allow read: if true;
      allow create, update: if isStaff() && isImageUnder5MB();
      allow delete: if isStaff();
    }

    match /doctor_department_images/{allPaths=**} {
      allow read: if true;
      allow create, update: if isStaff() && isImageUnder5MB();
      allow delete: if isStaff();
    }

    match /doctors/{allPaths=**} {
      allow read: if true;
      allow create, update: if isStaff() && isImageUnder5MB();
      allow delete: if isStaff();
    }

    // =========================
    // DEFAULT DENY
    // =========================
    match /{allPaths=**} {
      allow read, write: if false;
    }
    // =========================
    // BRANDING IMAGES
    // Header logo / favicon from Admin Settings
    // =========================
    match /branding/{type}/{fileName} {
      allow read: if true;

      allow create, update: if isStaff()
        && type in ['logos', 'favicons']
        && isImageUnder5MB();

      allow delete: if isStaff()
        && type in ['logos', 'favicons'];
    }
  }
}
