rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* =========================
       Common helpers
    ========================= */

    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function userExists(uid) {
      return exists(userPath(uid));
    }

    function userDoc(uid) {
      return get(userPath(uid));
    }

    function orderPath(orderId) {
      return /databases/$(database)/documents/orders/$(orderId);
    }

    function orderExists(orderId) {
      return exists(orderPath(orderId));
    }

    function orderDoc(orderId) {
      return get(orderPath(orderId));
    }

    function me() {
      return userDoc(request.auth.uid).data;
    }

    function notBanned() {
      return signedIn()
        && userExists(request.auth.uid)
        && me().isActive != false
        && me().isBanned != true;
    }

    function hasRole(role) {
      return notBanned()
        && (
          me().role == role ||
          (me().roles is list && role in me().roles)
        );
    }

    function isSuperAdmin() {
      return hasRole('superAdmin') || hasRole('super_admin');
    }

    function isAdmin() {
      return isSuperAdmin()
        || hasRole('admin')
        || hasRole('owner');
    }

    function isStaffRole() {
      return isAdmin() || hasRole('staff');
    }

    function adminDefault(permission) {
      return permission in [
        'dashboard.view',
        'analytics.view',

        'orders.view',
        'orders.edit',
        'orders.assign_rider',
        'orders.invoice',
        'orders.settle_cod',
        'orders.discount',
        'orders.confirm',

        'products.view',
        'products.edit',
        'products.delete',
        'products.bulk',
        'products.status',

        'vendor_products.view',
        'vendor_products.edit',
        'vendor_products.approve',
        'vendor_products.delete',
        'vendor_products.status',

        'categories.view',
        'categories.edit',
        'categories.delete',
        'categories.status',

        'banners.view',
        'banners.edit',
        'banners.delete',
        'banners.status',
        'banners.priority',

        'coupons.view',
        'coupons.edit',
        'coupons.delete',
        'coupons.status',

        'lists.view',
        'lists.edit',

        'doctors.view',
        'doctors.edit',
        'appointments.view',
        'appointments.edit',

        'vendors.view',
        'vendors.edit',
        'vendors.approve',
        'vendors.status',
        'vendors.documents',
        'vendors.contact',

        'delivery.view',
        'delivery.approve',
        'delivery.block',
        'delivery.contact',

        'referrals.view',
        'referrals.edit',

        'notifications.view',
        'notifications.send',
        'notifications.manage',
        'notifications.delete',
        'notifications.open_related',

        'settings.view'
      ];
    }

    function hasExplicitPermission(permission) {
      return notBanned()
        && (
          (
            me().permissions is list
            && permission in me().permissions
          )
          || (
            me().permissions is map
            && me().permissions[permission] == true
          )
        );
    }

    function dangerousPermissionKeys() {
      return [
        'users.permissions',
        'users.block',
        'wallet.edit',
        'settings.edit',
        'vendors.delete',
        'vendors.payouts',
        'delivery.withdraw',
        'delivery.settle_cod'
      ];
    }

    function requestHasDangerousPermissions() {
      return (
        request.resource.data.permissions is list
        && request.resource.data.permissions.hasAny(dangerousPermissionKeys())
      ) || (
        request.resource.data.permissions is map
        && request.resource.data.permissions.keys().hasAny(dangerousPermissionKeys())
      );
    }

    function permissionsFieldValid() {
      return !request.resource.data.keys().hasAny(['permissions'])
        || request.resource.data.permissions is list
        || request.resource.data.permissions is map;
    }

    function hasPermission(permission) {
      return can(permission);
    }

    function can(permission) {
      return notBanned()
        && (
          isSuperAdmin()
          || hasExplicitPermission(permission)
          || (
            hasRole('admin')
            && adminDefault(permission)
          )
        );
    }

    function isVendor() {
      return notBanned()
        && (
          hasRole('vendor')
          || me().sellerStatus in ['approved', 'Approved']
          || me().vendorStatus in ['approved', 'Approved']
          || (me().vendorId is string && me().vendorId != '')
        );
    }

    function myVendorId() {
      return me().vendorId;
    }

    // Vendor identity convention:
    // - request.auth.uid = vendor owner user UID
    // - me().vendorId = vendors/{vendorId} document id
    // - products.vendorId / orders.vendorIds = vendors/{vendorId}
    // - vendorOwnerId/vendorOwnerIds/sellerUid = owner UID fallback
    function ownsVendorId(vendorId) {
      return isVendor()
        && vendorId is string
        && (
          vendorId == request.auth.uid
          || (me().vendorId is string && vendorId == me().vendorId)
        );
    }

    function vendorProductCreateOwner(data) {
      return signedIn()
        && userExists(request.auth.uid)
        && data.vendorId is string
        && (
          data.vendorOwnerId == request.auth.uid
          || data.sellerUid == request.auth.uid
          || data.ownerId == request.auth.uid
          || data.userId == request.auth.uid
          || (data.vendorOwnerIds is list && request.auth.uid in data.vendorOwnerIds)
          || data.vendorId == request.auth.uid
          || (me().vendorId is string && data.vendorId == me().vendorId)
          || (
            exists(/databases/$(database)/documents/vendors/$(data.vendorId))
            && (
              get(/databases/$(database)/documents/vendors/$(data.vendorId)).data.ownerId == request.auth.uid
              || get(/databases/$(database)/documents/vendors/$(data.vendorId)).data.userId == request.auth.uid
            )
          )
        );
    }

    function ownsVendorData(data) {
      return isVendor()
        && (
          data.ownerId == request.auth.uid
          || data.userId == request.auth.uid
          || data.vendorOwnerId == request.auth.uid
          || data.sellerUid == request.auth.uid
          || data.vendorId == request.auth.uid
          || (data.vendorOwnerIds is list && request.auth.uid in data.vendorOwnerIds)
          || (me().vendorId is string && data.vendorId == me().vendorId)
          || (me().vendorId is string && data.sellerId == me().vendorId)
          || (me().vendorId is string && data.vendorIds is list && me().vendorId in data.vendorIds)
          || (me().vendorId is string && data.sellerIds is list && me().vendorId in data.sellerIds)
        );
    }

    function vendorInOrder(data) {
      return isVendor()
        && (
          data.vendorId == request.auth.uid
          || data.vendorOwnerId == request.auth.uid
          || data.sellerId == request.auth.uid
          || data.sellerUid == request.auth.uid
          || data.vendorUid == request.auth.uid
          || (data.vendorOwnerIds is list && request.auth.uid in data.vendorOwnerIds)
          || (data.sellerIds is list && request.auth.uid in data.sellerIds)
          || (data.vendorIds is list && request.auth.uid in data.vendorIds)
          || (me().vendorId is string && data.vendorId == me().vendorId)
          || (me().vendorId is string && data.sellerId == me().vendorId)
          || (me().vendorId is string && data.vendorIds is list && me().vendorId in data.vendorIds)
          || (me().vendorId is string && data.sellerIds is list && me().vendorId in data.sellerIds)
        );
    }

    function deliveryPartnerPath(uid) {
      return /databases/$(database)/documents/deliveryPartners/$(uid);
    }

    function deliveryPartnerDoc(uid) {
      return get(deliveryPartnerPath(uid));
    }

    function isDeliveryPartner() {
      return signedIn()
        && exists(deliveryPartnerPath(request.auth.uid))
        && (
          deliveryPartnerDoc(request.auth.uid).data.status == 'approved'
          || deliveryPartnerDoc(request.auth.uid).data.status == 'Approved'
        )
        && deliveryPartnerDoc(request.auth.uid).data.isActive != false;
    }

    function assignedDeliveryPartner(data) {
      return isDeliveryPartner()
        && data.deliveryPartnerId == request.auth.uid;
    }

    function changedOnly(allowed) {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(allowed);
    }

    function changedAny(fields) {
      return request.resource.data.diff(resource.data).changedKeys().hasAny(fields);
    }

    function validPositiveAmount(value) {
      return value is number && value > 0 && value <= 1000000;
    }

    function orderAmount(data) {
      return data.grandTotal is number
        ? data.grandTotal
        : (data.finalTotal is number ? data.finalTotal : data.total);
    }

    function isCodOrder(data) {
      return data.paymentMethod in ['COD', 'cod', 'cash_on_delivery', 'cash on delivery'];
    }

    function deliveryOrderReadyForEarning(orderId) {
      return orderId is string
        && orderExists(orderId)
        && orderDoc(orderId).data.deliveryPartnerId == request.auth.uid
        && (
          orderDoc(orderId).data.deliveryStatus == 'delivered'
          || orderDoc(orderId).data.status == 'delivered'
        )
        && orderDoc(orderId).data.deliveryCharge is number;
    }

    function validRiderEarningCreate() {
      return isDeliveryPartner()
        && request.resource.data.keys().hasOnly([
          'deliveryPartnerId',
          'orderId',
          'amount',
          'paymentMethod',
          'status',
          'grandTotal',
          'deliveryCharge',
          'partnerSynced',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.deliveryPartnerId == request.auth.uid
        && deliveryOrderReadyForEarning(request.resource.data.orderId)
        && request.resource.data.amount == orderDoc(request.resource.data.orderId).data.deliveryCharge
        && request.resource.data.deliveryCharge == orderDoc(request.resource.data.orderId).data.deliveryCharge
        && request.resource.data.grandTotal == orderAmount(orderDoc(request.resource.data.orderId).data)
        && request.resource.data.status == 'pending'
        && request.resource.data.partnerSynced == false;
    }

    function validRiderMoneySync(partnerId) {
      return signedIn()
        && request.auth.uid == partnerId
        && isDeliveryPartner()
        && changedOnly([
          'totalDeliveries',
          'totalEarning',
          'codDue',
          'lastEarningSyncedAt',
          'lastSyncedOrderId',
          'updatedAt'
        ])
        && deliveryOrderReadyForEarning(request.resource.data.lastSyncedOrderId)
        && (
          !resource.data.keys().hasAny(['lastSyncedOrderId'])
          || resource.data.lastSyncedOrderId != request.resource.data.lastSyncedOrderId
        )
        && request.resource.data.totalDeliveries == resource.data.totalDeliveries + 1
        && request.resource.data.totalEarning == resource.data.totalEarning + orderDoc(request.resource.data.lastSyncedOrderId).data.deliveryCharge
        && (
          (
            isCodOrder(orderDoc(request.resource.data.lastSyncedOrderId).data)
            && request.resource.data.codDue == resource.data.codDue + orderAmount(orderDoc(request.resource.data.lastSyncedOrderId).data)
          )
          || (
            !isCodOrder(orderDoc(request.resource.data.lastSyncedOrderId).data)
            && request.resource.data.codDue == resource.data.codDue
          )
        );
    }

    function validRiderWithdrawPending(partnerId) {
      return signedIn()
        && request.auth.uid == partnerId
        && isDeliveryPartner()
        && changedOnly([
          'pendingAmount',
          'lastWithdrawRequestId',
          'updatedAt'
        ])
        && request.resource.data.lastWithdrawRequestId is string
        && exists(/databases/$(database)/documents/deliveryWithdraws/$(request.resource.data.lastWithdrawRequestId))
        && get(/databases/$(database)/documents/deliveryWithdraws/$(request.resource.data.lastWithdrawRequestId)).data.deliveryPartnerId == request.auth.uid
        && get(/databases/$(database)/documents/deliveryWithdraws/$(request.resource.data.lastWithdrawRequestId)).data.status == 'pending'
        && request.resource.data.pendingAmount == resource.data.pendingAmount + get(/databases/$(database)/documents/deliveryWithdraws/$(request.resource.data.lastWithdrawRequestId)).data.amount;
    }

    /* =========================
       Users
    ========================= */

    match /users/{uid} {
      // Secure read:
      // A user can read only own profile.
      // Admin/staff users list/read all users only with users.view permission.
      allow get: if signedIn() && (request.auth.uid == uid || can('users.view'));
      allow list: if can('users.view');

      // ✅ Login/signup fix:
      // A signed-in user can create their own normal profile document.
      // This supports OTP/Google login flows where users/{uid} may not exist yet.
      // User cannot create admin/staff/superAdmin roles or sensitive fields.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && (
          !request.resource.data.keys().hasAny(['role'])
          || request.resource.data.role in ['user', 'customer']
        )
        && (
          !request.resource.data.keys().hasAny(['roles'])
          || (
            request.resource.data.roles is list
            && request.resource.data.roles.hasOnly(['user', 'customer'])
          )
        )
        && (
          !request.resource.data.keys().hasAny(['permissions'])
        )
        && (
          !request.resource.data.keys().hasAny(['isBanned'])
          || request.resource.data.isBanned == false
        )
        && (
          !request.resource.data.keys().hasAny(['isActive'])
          || request.resource.data.isActive == true
        )
        && (
          !request.resource.data.keys().hasAny(['points'])
          || request.resource.data.points == 0
        )
        && (
          !request.resource.data.keys().hasAny(['totalEarnings'])
          || request.resource.data.totalEarnings == 0
        )
        && (!request.resource.data.keys().hasAny(['whatsappOptIn']) || request.resource.data.whatsappOptIn == false)
        && (!request.resource.data.keys().hasAny(['whatsappNumber']) || request.resource.data.whatsappNumber == '');

      allow update: if signedIn()
        && request.auth.uid == uid
        && !changedAny([
          'role',
          'roles',
          'permissions',
          'isActive',
          'isBanned',
          'points',
          'totalEarnings',
          'sellerStatus',
          'vendorId',
          'banReason',
          'bannedAt',
          'isDeleted',
          'deletedAt'
        ])

        && (!changedAny(['whatsappOptIn']) || request.resource.data.whatsappOptIn is bool)
        && (!changedAny(['whatsappNumber']) || !request.resource.data.keys().hasAny(['whatsappNumber']) || request.resource.data.whatsappNumber.matches('^8801[0-9]{9}$'))
        && (!request.resource.data.keys().hasAny(['uid']) || request.resource.data.uid == uid);

      // ✅ Login profile refresh fix: allow user to refresh safe login/profile fields.
      allow update: if signedIn()
        && request.auth.uid == uid
        && !changedAny([
          'role',
          'roles',
          'permissions',
          'isActive',
          'isBanned',
          'points',
          'totalEarnings',
          'banReason',
          'bannedAt',
          'isDeleted',
          'deletedAt',
          'approvedAt'
        ])
        && (
          !changedAny(['sellerStatus'])
          || (
            resource.data.sellerStatus != 'approved'
            && request.resource.data.sellerStatus in ['none', 'new', 'pending', 'submitted']
          )
        )
        && (
          !changedAny(['vendorId'])
          || request.resource.data.vendorId == uid
        )

        && (!changedAny(['whatsappOptIn']) || request.resource.data.whatsappOptIn is bool)
        && (!changedAny(['whatsappNumber']) || !request.resource.data.keys().hasAny(['whatsappNumber']) || request.resource.data.whatsappNumber.matches('^8801[0-9]{9}$'))
        && (!request.resource.data.keys().hasAny(['uid']) || request.resource.data.uid == uid);


      // Allow a signed-in user to link their own pending seller application.
      // This is needed after creating vendors/{uid} from VendorApplyPage.
      // User cannot approve themselves; only pending/submitted is allowed here.
      allow update: if signedIn()
        && request.auth.uid == uid
        && changedOnly([
          'sellerStatus',
          'vendorId',
          'updatedAt'
        ])
        && resource.data.sellerStatus != 'approved'
        && request.resource.data.vendorId == uid
        && request.resource.data.sellerStatus in ['pending', 'submitted'];


      // Staff can edit non-sensitive profile/account fields.
      allow update: if can('users.edit')
        && !changedAny([
          'role',
          'roles',
          'permissions',
          'isActive',
          'isBanned',
          'points',
          'totalEarnings',
          'vendorId',
          'sellerStatus'
        ]);

      // Blocking / unblocking users.
      allow update: if can('users.block')
        && request.auth.uid != uid
        && changedOnly([
          'isActive',
          'isBanned',
          'banReason',
          'bannedAt',
          'updatedAt'
        ])
        && resource.data.role != 'superAdmin'
        && !(resource.data.roles is list && 'superAdmin' in resource.data.roles);

      // Wallet / ChalakChar Cash adjustments.
      allow update: if can('wallet.edit')
        && request.auth.uid != uid
        && changedOnly([
          'points',
          'totalEarnings',
          'updatedAt'
        ])
        && resource.data.role != 'superAdmin'
        && !(resource.data.roles is list && 'superAdmin' in resource.data.roles);

      // Permission changes for staff/admin users.
      // Non-super-admin cannot grant critical permissions.
      allow update: if can('users.permissions')
        && request.auth.uid != uid
        && changedOnly([
          'permissions',
          'updatedAt'
        ])
        && permissionsFieldValid()
        && (
          request.resource.data.role in ['staff', 'admin']
          || (request.resource.data.roles is list && (
            'staff' in request.resource.data.roles || 'admin' in request.resource.data.roles
          ))
        )
        && resource.data.role != 'superAdmin'
        && !(resource.data.roles is list && 'superAdmin' in resource.data.roles)
        && (
          isSuperAdmin()
          || !requestHasDangerousPermissions()
        );

      // Role changes.
      // SuperAdmin can change any non-self user role.
      // Non-super-admin with users.edit can only manage safe non-admin roles.
      allow update: if request.auth.uid != uid
        && changedOnly([
          'role',
          'roles',
          'sellerStatus',
          'vendorId',
          'isVendor',
          'isActive',
          'isBanned',
          'updatedAt'
        ])
        && (
          isSuperAdmin()
          || (
            can('users.edit')
            && request.resource.data.role in ['user', 'staff', 'vendor', 'deliveryPartner']
            && !(request.resource.data.roles is list && 'admin' in request.resource.data.roles)
            && !(request.resource.data.roles is list && 'superAdmin' in request.resource.data.roles)
            && resource.data.role != 'admin'
            && resource.data.role != 'superAdmin'
            && !(resource.data.roles is list && 'admin' in resource.data.roles)
            && !(resource.data.roles is list && 'superAdmin' in resource.data.roles)
          )
          || (
            (can('vendors.approve') || can('vendors.edit'))
            && request.resource.data.role in ['user', 'vendor']
            && request.resource.data.sellerStatus in ['approved', 'pending', 'submitted', 'rejected', 'suspended']
            && !(request.resource.data.roles is list && 'admin' in request.resource.data.roles)
            && !(request.resource.data.roles is list && 'superAdmin' in request.resource.data.roles)
            && resource.data.role != 'admin'
            && resource.data.role != 'superAdmin'
            && !(resource.data.roles is list && 'admin' in resource.data.roles)
            && !(resource.data.roles is list && 'superAdmin' in resource.data.roles)
          )
        );

      allow delete: if isSuperAdmin();

      match /wishlist/{productId} {
              allow read, create, update, delete:
                if signedIn() && request.auth.uid == uid;
            }

      match /addresses/{addressId} {
        allow read, create, update, delete:
          if signedIn() && request.auth.uid == uid;
      }
    }

    // match /users/{uid} শেষ
    match /whatsapp_deliveries/{docId} {
      allow read: if can('analytics.view') || can('marketing.view') || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /marketing_outbox/{docId} {
      allow read: if can('analytics.view') || can('notifications.view') || can('marketing.view');
      allow update: if can('marketing.manage') || can('marketing.retry') || isSuperAdmin();
      allow create, delete: if can('marketing.manage') || isSuperAdmin();
    }

    match /marketing_logs/{docId} {
      allow read: if can('analytics.view') || can('notifications.view') || can('marketing.view');
      allow create, update, delete: if can('marketing.manage') || isSuperAdmin();
    }

    match /product_marketing_scores/{docId} {
      allow read: if can('analytics.view') || can('notifications.view') || can('marketing.view');
      allow create, update, delete: if can('marketing.manage') || isSuperAdmin();
    }

    match /campaign_analytics/{docId} {
      allow read: if can('analytics.view') || can('notifications.view') || can('marketing.view');
      allow create, update, delete: if can('marketing.manage') || isSuperAdmin();
    }

    // TikTok integration — server-only collections (Admin SDK bypasses rules;
    // these deny every direct client read/write). Client-readable status
    // fields live on settings/app instead (tiktokConnectionStatus etc.).
    match /tiktok_connections/{connectionId} {
      allow read, write: if false;
    }

    match /tiktok_oauth_states/{stateId} {
      allow read, write: if false;
    }

    match /tiktok_publish_jobs/{jobId} {
      allow read: if can('analytics.view') || can('marketing.view') || isSuperAdmin();
      allow create, update, delete: if false;
    }

    // Sanitized, server-derived status projection (see
    // functions/tiktok/connectionStatusProjection.js) — this is the ONLY
    // TikTok collection Flutter reads directly. It never contains tokens.
    match /tiktok_connection_status/{connectionId} {
      allow read: if can('analytics.view') || can('marketing.view') || isSuperAdmin();
      allow create, update, delete: if false;
    }

    // Webhook event dedup ledger (functions/tiktok/webhookDedup.js) —
    // server-only, no admin UI needs to read this.
    match /tiktok_webhook_events/{eventId} {
      allow read, write: if false;
    }

    match /user_marketing_profiles/{uid} {
      allow read: if can('analytics.view') || can('notifications.view') || can('marketing.view') || request.auth.uid == uid;
      allow create, update, delete: if can('marketing.manage') || isSuperAdmin();
    }


    /* =========================
       Vendors
    ========================= */

    match /vendors/{vendorId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status in ['pending', 'submitted']
        && request.resource.data.isActive == false;

      allow update: if can('vendors.edit') || can('vendors.approve') || can('vendors.status');

      // Applicant/vendor owner can create or update own application while it is pending/rejected/submitted.
      // They cannot approve themselves or edit money/commission fields.
      allow update: if signedIn()
        && (
          resource.data.ownerId == request.auth.uid
          || resource.data.userId == request.auth.uid
          || request.resource.data.ownerId == request.auth.uid
          || request.resource.data.userId == request.auth.uid
        )
        && resource.data.status in ['pending', 'submitted', 'rejected', 'new']
        && request.resource.data.status in ['pending', 'submitted']
        && request.resource.data.isActive == false
        && request.resource.data.isVerified == false
        && !changedAny([
          'commissionPercent',
          'commissionRate',
          'totalSales',
          'totalOrders',
          'withdrawableBalance',
          'withdrawPendingBalance',
          'approvedAt',
          'suspendedAt'
        ]);

      // Vendor owner can update only profile/docs fields, not approval/money/status fields.
      allow update: if ownsVendorData(resource.data)
        && !changedAny([
          'status',
          'isActive',
          'isVerified',
          'commissionPercent',
          'commissionRate',
          'totalSales',
          'totalOrders',
          'withdrawableBalance',
          'withdrawPendingBalance',
          'approvedAt',
          'rejectedAt',
          'suspendedAt'
        ]);

      allow delete: if can('vendors.delete') || isSuperAdmin();
    }

    match /vendorWithdrawRequests/{requestId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;

      allow update, delete: if isSuperAdmin()
        || hasRole('admin')
        || can('vendors.edit')
        || can('vendors.approve')
        || can('vendors.payouts');
    }



    match /vendorPayouts/{payoutId} {
      allow read: if can('vendors.view') || can('analytics.view');
      allow create, update, delete: if can('vendors.edit') || can('vendors.approve');
    }

    match /vendorCommissions/{docId} {
      allow read: if can('vendors.view')
        || can('analytics.view')
        || (
          isVendor()
          && (
            resource.data.vendorId == request.auth.uid
            || resource.data.vendorOwnerId == request.auth.uid
            || (me().vendorId is string && resource.data.vendorId == me().vendorId)
          )
        );

      allow create, update, delete: if can('vendors.edit') || can('orders.edit');
    }

    /* =========================
       Delivery partners
    ========================= */

    match /deliveryPartners/{partnerId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.auth.uid == partnerId;

      allow update: if signedIn()
        && (
          request.auth.uid == partnerId
          || isSuperAdmin()
          || hasRole('admin')
          || can('delivery.approve')
          || can('delivery.block')
          || can('delivery.withdraw')
          || can('delivery.settle_cod')
        );

      allow delete: if isSuperAdmin();
    }
    match /deliveryEarnings/{docId} {
      allow read: if signedIn();

      // Easy safe earning rule:
      // rider can create/update only own earning document.
      allow create: if signedIn()
        && request.resource.data.deliveryPartnerId == request.auth.uid;

      allow update: if signedIn()
        && (
          resource.data.deliveryPartnerId == request.auth.uid
          || request.resource.data.deliveryPartnerId == request.auth.uid
        );

      allow delete: if can('delivery.approve')
        || can('delivery.settle_cod')
        || isSuperAdmin();
    }

    match /deliveryWithdraws/{withdrawId} {
      allow read: if signedIn()
        && (
          can('delivery.view')
          || can('delivery.withdraw')
          || can('delivery.settle_cod')
          || resource.data.deliveryPartnerId == request.auth.uid
        );

      allow create: if isDeliveryPartner()
        && request.resource.data.keys().hasOnly([
          'deliveryPartnerId',
          'amount',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.deliveryPartnerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && validPositiveAmount(request.resource.data.amount);

      allow update, delete: if can('delivery.withdraw')
        || can('delivery.settle_cod')
        || isSuperAdmin();
    }

    /* =========================
       Products    /* =========================
       Products / categories / banners / coupons
    ========================= */

match /products/{productId} {
  allow read: if true;

  allow create: if can('products.edit')
    || (
      signedIn()
      && userExists(request.auth.uid)
      && vendorProductCreateOwner(request.resource.data)
    );

  allow update: if can('products.edit')
    || can('products.status')
    || (
      signedIn()
      && userExists(request.auth.uid)
      && ownsVendorProduct(resource.data)
    );

  allow delete: if can('products.delete')
    || isSuperAdmin()
    || (
      signedIn()
      && userExists(request.auth.uid)
      && ownsVendorProduct(resource.data)
    );
}

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if can('categories.edit');
      allow delete: if can('categories.delete') || isSuperAdmin();
    }

    // Search analytics. Shoppers (signed in or guest) may only append one
    // well-formed entry. No read/update/delete for shoppers: this holds
    // everyone's queries. Staff with analytics.view read it through the
    // catch-all analytics rule at the bottom of this file.
    // Nothing personal is stored beyond an optional userId, which must be
    // the caller's own uid.
    match /search_logs/{logId} {
      allow create: if request.resource.data.keys().hasOnly(
            ['query', 'displayQuery', 'source', 'resultCount', 'createdAt', 'userId'])
        && request.resource.data.keys().hasAll(['query', 'resultCount', 'createdAt'])
        && request.resource.data.query is string
        && request.resource.data.query.size() > 0
        && request.resource.data.query.size() <= 100
        && (!('displayQuery' in request.resource.data)
            || (request.resource.data.displayQuery is string
                && request.resource.data.displayQuery.size() <= 100))
        && (!('source' in request.resource.data)
            || (request.resource.data.source is string
                && request.resource.data.source.size() <= 40))
        && request.resource.data.resultCount is int
        && request.resource.data.resultCount >= 0
        && request.resource.data.resultCount <= 100000
        && request.resource.data.createdAt == request.time
        && (!('userId' in request.resource.data)
            || (signedIn() && request.resource.data.userId == request.auth.uid));
      allow update, delete: if false;
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow create, update: if can('banners.edit') || can('banners.status') || can('banners.priority');
      allow delete: if can('banners.delete') || isSuperAdmin();
    }

    match /coupons/{couponCode} {
      allow read: if true;
      allow create, update: if can('coupons.edit') || can('coupons.status');
      allow delete: if can('coupons.delete') || isSuperAdmin();
    }

    match /analytics/{document=**} {
      allow read: if signedIn()
        && userExists(request.auth.uid)
        && (can('analytics.view') || hasRole('staff'));

      allow create, update, delete: if can('analytics.edit') || isSuperAdmin();
    }

    /* =========================
       Orders / cart / lists
    ========================= */

    match /cart/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;

      match /items/{itemId} {
        allow read, create, update, delete:
          if signedIn() && request.auth.uid == uid;
      }
    }

    match /orders/{orderId} {
      allow create: if signedIn();

      allow get: if signedIn();
      allow list: if signedIn();

      allow update: if signedIn();

      allow delete: if isSuperAdmin();
    }




    match /lists/{listId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow read: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || can('lists.view')
          || can('lists.edit')
          || can('analytics.view')
        );

      allow update, delete: if can('lists.edit') || isSuperAdmin();
    }

    /* =========================
       Notifications / referrals / wallet logs
    ========================= */

    match /notifications/{docId} {
      allow read: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || can('notifications.view')
          || can('notifications.manage')
        );

      // User can create only their own notification; staff can send broadcasts/admin notifications.
      allow create: if notBanned()
        && (
          can('notifications.send')
          || request.resource.data.userId == request.auth.uid
        );

      allow update: if signedIn()
        && (
          can('notifications.manage')
          || (
            resource.data.userId == request.auth.uid
            && changedOnly(['isRead', 'readAt', 'updatedAt'])
          )
        );

      allow delete: if can('notifications.delete') || can('notifications.manage');
    }

    match /vendor_notifications/{docId} {
      allow read: if signedIn()
        && (
          resource.data.vendorId == request.auth.uid
          || resource.data.vendorOwnerId == request.auth.uid
          || (me().vendorId is string && resource.data.vendorId == me().vendorId)
          || can('notifications.view')
          || can('vendors.view')
        );

      allow create: if notBanned()
        && (
          can('notifications.send')
          || can('vendors.edit')
          || request.resource.data.vendorOwnerId == request.auth.uid
          || request.resource.data.vendorId == request.auth.uid
          || (me().vendorId is string && request.resource.data.vendorId == me().vendorId)
        );

      allow update: if signedIn()
        && (
          can('notifications.manage')
          || resource.data.vendorOwnerId == request.auth.uid
          || resource.data.vendorId == request.auth.uid
          || (me().vendorId is string && request.resource.data.vendorId == me().vendorId)
        );

      allow delete: if can('notifications.delete') || can('notifications.manage');
    }

    match /referrals/{docId} {
      allow read: if can('users.view') || can('users.edit') || can('wallet.edit') || can('analytics.view');

      allow create: if signedIn()
        && request.resource.data.referrerId != request.auth.uid
        && request.resource.data.referredUserId == request.auth.uid;

      allow update, delete: if can('wallet.edit') || can('users.edit');
    }

    match /wallet_logs/{docId} {
      allow read: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || can('wallet.edit')
          || can('users.view')
          || can('analytics.view')
        );

      allow create, update, delete: if can('wallet.edit');
    }

    /* =========================
       Doctors / appointments / settings
    ========================= */

    match /doctor_departments/{deptId} {
      allow read: if true;
      allow create, update, delete: if can('doctors.edit') || can('settings.edit');
    }

    match /doctors/{doctorId} {
      allow read: if true;
      allow create, update, delete: if can('doctors.edit') || can('settings.edit');
    }



    match /doctor_slots/{slotId} {
      allow read: if true;
      allow create, update, delete: if can('doctors.edit') || can('settings.edit');
    }

    match /doctor_time_slots/{slotId} {
      allow read: if true;
      allow create, update, delete: if can('doctors.edit') || can('settings.edit');
    }

    match /doctor_schedules/{scheduleId} {
      allow read: if true;
      allow create, update, delete: if can('doctors.edit') || can('settings.edit');
    }

    match /doctor_appointments/{appointmentId} {
      // Public slot availability needs to read existing booked appointments.
      // Booking/create/update/delete are still protected below.
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.bookedByUserId == request.auth.uid;

      allow update: if can('doctors.edit')
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && changedOnly(['status', 'cancelledAt', 'updatedAt'])
        );

      allow delete: if can('doctors.edit') || isSuperAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow create, update: if can('settings.edit');
      allow delete: if isSuperAdmin();
    }

    /* =========================
       Default deny
    ========================= */

    // Analytics staff/admin needs to read multiple collections for totals/charts.
    // Write remains denied here; write permissions are controlled above.
    match /{document=**} {
      allow read: if signedIn()
        && userExists(request.auth.uid)
        && (can('analytics.view') || hasRole('staff'));

      allow write: if false;
    }
  }
}
