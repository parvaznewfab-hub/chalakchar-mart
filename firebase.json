{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "build/web",
    "predeploy": [
      "node tools/web/finalize_web_build.js build/web"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/@(index.html|flutter_bootstrap.js|flutter_service_worker.js|flutter.js|main.dart.js|version.json|manifest.json)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/assets/*",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/aliexpress/start",
        "function": {
          "functionId": "aliexpressOAuthStart",
          "region": "asia-south1"
        }
      },
      {
        "source": "/api/aliexpress/callback",
        "function": {
          "functionId": "aliexpressOAuthCallback",
          "region": "asia-south1"
        }
      },
      {
        "source": "/api/aliexpress/status",
        "function": {
          "functionId": "aliexpressConnectionStatus",
          "region": "asia-south1"
        }
      },
      {
        "source": "/sitemap.xml",
        "function": {
          "functionId": "sitemap",
          "region": "asia-south1"
        }
      },
      {
        "source": "/product/**",
        "function": {
          "functionId": "productSeo",
          "region": "asia-south1"
        }
      },
      {
        "source": "/",
        "function": {
          "functionId": "homeSeo",
          "region": "asia-south1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}