{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/sitemap.xml",
        "function": {
          "functionId": "sitemap",
          "region": "asia-south1"
        }
      },
      {
        "source": "/product/**",
        "function": {
          "functionId": "productSeo",
          "region": "asia-south1"
        }
      },
      {
        "source": "/",
        "function": {
          "functionId": "homeSeo",
          "region": "asia-south1"
        }
      },
      {
        "source": "**",
        "destination": "/app.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}